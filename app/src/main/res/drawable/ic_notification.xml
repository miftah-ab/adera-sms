<?xml version="1.0" encoding="utf-8"?>
<!-- Notification icon for the foreground service persistent notification.
     Must be monochrome (white on transparent) — Android tints it with the
     notification color at runtime. Using a simple speech-bubble + checkmark
     that matches the icon concept from the product spec. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Speech bubble body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4V22L6,18H20C21.1,18 22,17.1 22,16V4C22,2.9 21.1,2 20,2Z"/>
    <!-- Checkmark inside bubble (indicates "reply sent") -->
    <path
        android:fillColor="#1B5E20"
        android:pathData="M10,13.17L7.83,11L6.41,12.41L10,16L17.41,8.59L16,7.17L10,13.17Z"/>
</vector>
