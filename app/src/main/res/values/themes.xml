<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 theme — Adera SMS
    Dark-mode-first (budget phones in Ethiopia commonly run in dark mode to save battery).
    The Compose MaterialTheme is configured in code (AderaSmsTheme.kt).
    This XML theme is applied to the Activity window/status bar via AndroidManifest.
-->
<resources>
    <style name="Theme.AderaSms" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Window chrome colors -->
        <item name="android:statusBarColor">@color/brand_green_900</item>
        <item name="android:navigationBarColor">@color/brand_green_bg_dark</item>
        <item name="android:windowBackground">@color/brand_green_bg_dark</item>
        <item name="android:colorBackground">@color/brand_green_bg_dark</item>
    </style>

    <!-- Splash screen theme (avoids a white flash on launch) -->
    <style name="Theme.AderaSms.Splash" parent="Theme.AderaSms">
        <item name="android:windowBackground">@color/brand_green_bg_dark</item>
    </style>
</resources>
