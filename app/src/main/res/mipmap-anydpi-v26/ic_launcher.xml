<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon — square variant (API 26+).
     Background: exact icon background green (#003C2D) matching aderasms-logo.png.
     Foreground: PNG version of the golden mark for crisp rendering at all densities.
     The launcher clips this to its preferred shape (circle, squircle, rounded square, etc). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/brand_icon_bg"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
